double CalculateMonthlyPayment(double loan_amount, double annual_interest_rate, double number_of_years)
{
	double total_amount, monthly_amount;
	total_amount = (loan_amount)+(number_of_years * loan_amount * (annual_interest_rate / 100.00));
	total_amount = (loan_amount)+(number_of_years * loan_amount) * (annual_interest_rate / 100.00);
	monthly_amount = (total_amount / (number_of_years * 12));
	return monthly_amount;
} //End Calculate Monthly Payment Function

double CalculateLoanAmount(double monthly_amount, double annual_interest_rate, double number_of_years)
{
	double loan_amount;
	loan_amount = (monthly_amount) * (number_of_years * 12);
	return loan_amount;
} //End Calculate Loan Amount Function

double CalculateLengthofLoan(double monthly_amount, double annual_interest_rate, double loan_amount, double total_amount)
{
	double number_of_years;
	number_of_years = (total_amount / (monthly_amount) / 12);
	return number_of_years;
} //End Calculate Length of Loan Function

double CalculateInterestRate(double loan_amount, double monthly_amount, double number_of_years, double total_amount)
{
	double annual_interest_rate;
	annual_interest_rate = ((total_amount)-(loan_amount)) / (loan_amount) / (number_of_years) * 100;
	return annual_interest_rate;
} //End Calculate Interest Rate Function

